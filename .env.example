# KashBites Environment Variables Configuration
# Copy this file to .env and adjust variables as needed

# Server & App Configuration
PORT=5000
NODE_ENV=development
APP_URL="http://localhost:3000"

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/kashbites
# For Docker Compose: MONGODB_URI=mongodb://mongodb:27017/kashbites

# MinIO Object Storage Configuration (Static Media: Product & Review Images)
MINIO_ROOT_USER=kashbites_admin
MINIO_ROOT_PASSWORD=kashbites_minio_secret_2026
MINIO_ENDPOINT=localhost
# For Docker Compose: MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=kashbites_admin
MINIO_SECRET_KEY=kashbites_minio_secret_2026
MINIO_BUCKET_NAME=kashbites-media
MINIO_PUBLIC_URL=http://localhost:9000

# JWT Authentication Secret
JWT_SECRET=kashbites_kashmir_authentic_secret_key_2026

# CORS Origin for Frontend & Admin Panel
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Default Seeded Admin Credentials
ADMIN_DEFAULT_USER=shoaibwani
ADMIN_DEFAULT_PASSWORD=kashbites@admin2026

# Shipping Provider Webhook Configuration
SHIPPING_WEBHOOK_SECRET=kb_whsec_kashmir_2026
SHIPPING_OUTBOUND_WEBHOOK_URL=https://api.shiprocket.in/v1/external/orders/create/adhoc

# Client Vite Configuration (Prefix with VITE_)
VITE_API_BASE_URL=/api
VITE_MINIO_PUBLIC_URL=http://localhost:9000/kashbites-media
VITE_BRAND_NAME="KashBites"
VITE_BRAND_TAGLINE="A Taste of Kashmir"

# Optional Gemini API Key
GEMINI_API_KEY=""

