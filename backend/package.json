{
  "name": "kashbites-backend",
  "version": "1.0.0",
  "description": "Backend API for KashBites Kashmir Dry Fruits e-commerce platform with MongoDB & MinIO",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "test": "node --test --test-force-exit tests/**/*.test.js",
    "workers": "node src/workers/main.js",
    "crons": "node src/crons/main.cron.js",
    "validate": "node -e \"import('./src/swagger/index.js')\""
  },
  "dependencies": {
    "bullmq": "^6.7.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "minio": "^8.0.4",
    "mongoose": "^8.9.5",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "razorpay": "^2.9.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
